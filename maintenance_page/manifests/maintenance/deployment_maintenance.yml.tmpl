apiVersion: apps/v1
kind: Deployment
metadata:
  name: cpd-tsh-maintenance
  labels:
    app: cpd-tsh-maintenance

spec:
  replicas: 2

  selector:
    matchLabels:
      app: cpd-tsh-maintenance

  template:
    metadata:
      labels:
        app: cpd-tsh-maintenance

    spec:
      nodeSelector:
        teacherservices.cloud/node_pool: applications
        kubernetes.io/os: linux

      containers:
        - name: cpd-tsh-maintenance
          image: ghcr.io/dfe-digital/teaching-school-hub-finder-maintenance:#MAINTENANCE_IMAGE_TAG#

          securityContext:
            allowPrivilegeEscalation: false
            runAsNonRoot: true

          ports:
            - containerPort: 8080

          resources:
            requests:
              memory: 64M
              cpu: 0.1

            limits:
              memory: 64M
              cpu: 1